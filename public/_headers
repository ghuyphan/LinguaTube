# Service Worker & Manifest - never cache so updates are discovered immediately
/ngsw.json
  Cache-Control: no-cache, no-store, must-revalidate

/ngsw-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed production bundles - cache forever
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Static assets with long-term caching
/icons/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# SEO crawler discovery files
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

# Global headers for all routes
/*
  Content-Security-Policy: frame-ancestors 'self' https://accounts.google.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
